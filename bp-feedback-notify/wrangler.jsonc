{
  "name": "svbc-bp-feedback-notify",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "preview_urls": false,
  "upload_source_maps": true,
  "workers_dev": true,
  // Reuses mail.bikesiliconvalley.org, already onboarded to Cloudflare Email Sending for
  // member-portal — no new domain onboarding needed for this Worker.
  "send_email": [{ "name": "EMAIL" }],
  // Per-item resend guard (GL#105, src/sendGuard.ts). SVBC's database was created 2026-11-14; a fork
  // creates its own with `wrangler d1 create svbc-bp-feedback-notify` and pastes the id here. Apply
  // migrations/ with `wrangler d1 migrations apply svbc-bp-feedback-notify --remote` before the
  // first deploy: until the table exists every send fails closed with a 503.
  "d1_databases": [{ "binding": "DB", "database_name": "svbc-bp-feedback-notify", "database_id": "ee63819e-d723-447b-9987-48632f26eceb", "migrations_dir": "migrations" }],
  // Write-switch flags (scripts/flags.mjs). The namespace is `FLAGS` (`sandbox-FLAGS` under
  // env.sandbox); every in-scope Worker carries the same two ids, which
  // scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  // Traffic/cost guardrails — see README "Reliability: traffic and cost limits". 60/min/IP is
  // generous against real volume (staff-triggered bike-valet feedback requests) while blunting a
  // flood against a route that does email-sending work before the shared-secret check ever
  // rejects a bogus request.
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2011", "simple": { "limit": 60, "period": 60 } }],
  // Workers Paid (this account's plan) defaults to 30s CPU/request; cap it far lower as a
  // guardrail against a runaway invocation or a surprise bill. See the root README.
  "limits": { "cpu_ms": 100 },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  // Monday access: the monday-auth broker's Staff sync app (SyncToken entrypoint), which owns
  // the OAuth token and its refresh. src/mondayApi.ts tokenProviderFor prefers this binding
  // over a MONDAY_API_TOKEN secret. Design: docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "SyncToken" }],
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-bp-feedback-notify-sandbox.
  // Rule: inbound data only, no outbound data — the EMAIL binding below may only deliver to the
  // one sink address, enforced by Cloudflare (E_RECIPIENT_NOT_ALLOWED otherwise); the code layer
  // in src/email/sandboxBinding.ts rewrites recipients to the same address. Same convention as
  // member-portal — see its wrangler.jsonc and
  // docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — set the sandbox copy with `wrangler secret put WEBHOOK_SECRET --env sandbox`.
  // Monday access comes from the MONDAY_AUTH binding, not a MONDAY_API_TOKEN secret.
  "env": {
    "sandbox": {
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "sandbox",
        // Must equal allowed_destination_addresses[0] below — config/split.test.ts checks.
        "SANDBOX_EMAIL_SINK": "sandbox@bikesiliconvalley.org"
      },
      "workers_dev": true,
      // Explicit, so the sandbox never inherits a route added to production later.
      "routes": [],
      "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["sandbox@bikesiliconvalley.org"] }],
      // The sandbox resend-guard database (same setup as production's, with --env sandbox).
      "d1_databases": [{ "binding": "DB", "database_name": "svbc-bp-feedback-notify-sandbox", "database_id": "6d57074a-7bbc-4b25-9499-879a48c4c69f", "migrations_dir": "migrations" }],
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2012", "simple": { "limit": 60, "period": 60 } }],
      "limits": { "cpu_ms": 100 },
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      },
      // The sandbox broker, consented as Sandbox Integration.
      "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "SyncToken" }]
    }
  }
}
