---
layout: layouts/base.njk
title: Home
permalink: /
---

<h1>Bike Lanes in the Bay Area</h1>

<p>Tracking bicycle infrastructure in San Mateo and Santa Clara Counties.</p>

<section class="summary">
  <h2>Regional Total</h2>
  <div class="stat-cards">
    <div class="stat-card stat-card-large">
      <span class="stat-value">{{ bikelanes.totals.miles | formatDistance('mi') | safe }}</span>
      <span class="stat-label">miles of Bike Lanes</span>
      <span class="stat-alt">({{ bikelanes.totals.miles | formatDistance('km') | safe }} kilometers)</span>
    </div>
  </div>
</section>

<section>
  <h2>By County</h2>
  <table>
    <thead>
      <tr>
        <th>County</th>
        <th>Miles</th>
        <th>Kilometers</th>
      </tr>
    </thead>
    <tbody>
      {% for countyName, county in bikelanes.counties %}
      <tr>
        <td>{{ countyName }}</td>
        <td data-label="Miles">{{ county.totalMiles | formatDistance('mi') | safe }}</td>
        <td data-label="Kilometers">{{ county.totalMiles | formatDistance('km') | safe }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2>By Bike Lane Class</h2>
  <table>
    <thead>
      <tr>
        <th>Class</th>
        <th>Miles</th>
        <th>Kilometers</th>
      </tr>
    </thead>
    <tbody>
      {% for item in bikelanes.totals.byClass %}
      <tr>
        <td>{{ item.className }}</td>
        <td data-label="Miles">{{ item.miles | formatDistance('mi') | safe }}</td>
        <td data-label="Kilometers">{{ item.miles | formatDistance('km') | safe }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2>County Details</h2>
  {% for countyName, county in bikelanes.counties %}
  <h3>{{ countyName }} County</h3>
  <table>
    <thead>
      <tr>
        <th>Class</th>
        <th>Miles</th>
        <th>Kilometers</th>
      </tr>
    </thead>
    <tbody>
      {% for item in county.byClass %}
      <tr>
        <td>{{ item.className }}</td>
        <td data-label="Miles">{{ item.miles | formatDistance('mi') | safe }}</td>
        <td data-label="Kilometers">{{ item.miles | formatDistance('km') | safe }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</section>

<section>
  <h2>By City</h2>
  {% for countyName, county in bikelanes.counties %}
  <h3>{{ countyName }} County</h3>
  <table>
    <thead>
      <tr>
        <th>City</th>
        <th>Miles</th>
        <th>Kilometers</th>
      </tr>
    </thead>
    <tbody>
      {% for city in county.byCity %}
      <tr>
        <td>{{ city.name }}</td>
        <td data-label="Miles">{{ city.miles | formatDistance('mi') | safe }}</td>
        <td data-label="Kilometers">{{ city.miles | formatDistance('km') | safe }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</section>

<section>
  <h2>Historical Trends</h2>
  {% if history.snapshots.length > 0 %}
  <p>Tracking changes in bike infrastructure over time.</p>
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Total Miles</th>
        <th>Total Kilometers</th>
        <th>Change</th>
      </tr>
    </thead>
    <tbody>
      {% set reversedSnapshots = history.snapshots | reverse %}
      {% for snapshot in reversedSnapshots %}
      {% set prevIndex = loop.index %}
      {% set prevSnapshot = reversedSnapshots[prevIndex] if prevIndex < reversedSnapshots.length else null %}
      <tr>
        <td>{{ snapshot.date | shortDate }}</td>
        <td data-label="Total Miles">{{ snapshot.totals.miles | formatDistance('mi') | safe }}</td>
        <td data-label="Total Kilometers">{{ snapshot.totals.miles | formatDistance('km') | safe }}</td>
        <td data-label="Change" class="change {% if prevSnapshot %}{% if snapshot.totals.miles > prevSnapshot.totals.miles %}positive{% elif snapshot.totals.miles < prevSnapshot.totals.miles %}negative{% endif %}{% endif %}">
          {% if prevSnapshot %}
            {{ (snapshot.totals.miles - prevSnapshot.totals.miles) | formatChangeWithUnit('mi') }}
          {% else %}
            —
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="no-data">No historical data available yet. Data will be collected during weekly builds.</p>
  {% endif %}
</section>

<section class="methodology">
  <h2>About This Data</h2>
  <p>This tracker displays bike lane infrastructure data for San Mateo and Santa Clara Counties in the San Francisco Bay Area. Data is sourced from the <a href="https://opendata.mtc.ca.gov/datasets/regional-bike-facilities">MTC Regional Bike Facilities</a> dataset maintained by the Metropolitan Transportation Commission.</p>
  <h3>Bike Lane Classifications</h3>
  <ul>
    <li><strong>Class I - Bike Path:</strong> Separate paved paths for bicycles and pedestrians, physically separated from motor vehicle traffic</li>
    <li><strong>Class II - Bike Lane:</strong> Striped lanes on streets designated for bicycle use</li>
    <li><strong>Class III - Bike Route:</strong> Shared roadways with signage indicating bicycle routes</li>
  </ul>
  <p><small>Data is refreshed weekly. Historical tracking began when this site was launched.</small></p>
</section>

<footer class="data-info">
  <p><small>Last updated: {{ bikelanes.fetchedAt | readableDate }}</small></p>
  <p><small>Source: <a href="{{ bikelanes.sourceUrl }}">{{ bikelanes.source }}</a></small></p>
