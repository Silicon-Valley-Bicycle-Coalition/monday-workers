---
layout: layouts/base.njk
title: Home
---

<h1>Bike Lanes in the Bay Area</h1>

<p>Tracking bicycle infrastructure in San Mateo and Santa Clara Counties.</p>

<section class="summary">
  <h2>Regional Totals</h2>
  <div class="stat-cards">
    <div class="stat-card">
      <span class="stat-value">{{ bikelanes.totals.miles | round(1) }}</span>
      <span class="stat-label">Total Miles</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{{ bikelanes.totals.segments | localeNumber }}</span>
      <span class="stat-label">Segments</span>
    </div>
  </div>
</section>

<section>
  <h2>By County</h2>
  <table>
    <thead>
      <tr>
        <th>County</th>
        <th>Total Miles</th>
        <th>Segments</th>
      </tr>
    </thead>
    <tbody>
      {% for countyName, county in bikelanes.counties %}
      <tr>
        <td>{{ countyName }}</td>
        <td data-label="Total Miles">{{ county.totalMiles | round(1) }}</td>
        <td data-label="Segments">{{ county.totalSegments | localeNumber }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2>By Bike Lane Class</h2>
  <table>
    <thead>
      <tr>
        <th>Class</th>
        <th>Total Miles</th>
        <th>Segments</th>
      </tr>
    </thead>
    <tbody>
      {% for item in bikelanes.totals.byClass %}
      <tr>
        <td>{{ item.className }}</td>
        <td data-label="Total Miles">{{ item.miles | round(1) }}</td>
        <td data-label="Segments">{{ item.segments | localeNumber }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2>County Details</h2>
  {% for countyName, county in bikelanes.counties %}
  <h3>{{ countyName }} County</h3>
  <table>
    <thead>
      <tr>
        <th>Class</th>
        <th>Miles</th>
        <th>Segments</th>
      </tr>
    </thead>
    <tbody>
      {% for item in county.byClass %}
      <tr>
        <td>{{ item.className }}</td>
        <td data-label="Miles">{{ item.miles | round(1) }}</td>
        <td data-label="Segments">{{ item.segments | localeNumber }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</section>

<section>
  <h2>Historical Trends</h2>
  {% if history.snapshots.length > 0 %}
  <p>Tracking changes in bike infrastructure over time.</p>
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Total Miles</th>
        <th>Change</th>
        <th>San Mateo</th>
        <th>Santa Clara</th>
      </tr>
    </thead>
    <tbody>
      {% set reversedSnapshots = history.snapshots | reverse %}
      {% for snapshot in reversedSnapshots %}
      {% set prevIndex = loop.index %}
      {% set prevSnapshot = reversedSnapshots[prevIndex] if prevIndex < reversedSnapshots.length else null %}
      <tr>
        <td>{{ snapshot.date | shortDate }}</td>
        <td data-label="Total Miles">{{ snapshot.totals.miles | round(1) | localeNumber }}</td>
        <td data-label="Change" class="change {% if prevSnapshot %}{% if snapshot.totals.miles > prevSnapshot.totals.miles %}positive{% elif snapshot.totals.miles < prevSnapshot.totals.miles %}negative{% endif %}{% endif %}">
          {% if prevSnapshot %}
            {{ (snapshot.totals.miles - prevSnapshot.totals.miles) | formatChange }}
          {% else %}
            —
          {% endif %}
        </td>
        <td data-label="San Mateo">{{ snapshot.counties['San Mateo'].totalMiles | round(1) }}</td>
        <td data-label="Santa Clara">{{ snapshot.counties['Santa Clara'].totalMiles | round(1) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="no-data">No historical data available yet. Data will be collected during weekly builds.</p>
  {% endif %}
</section>

<footer class="data-info">
  <p><small>Data fetched: {{ bikelanes.fetchedAt | readableDate }}</small></p>
  <p><small>Source: <a href="{{ bikelanes.sourceUrl }}">{{ bikelanes.source }}</a></small></p>
</footer>
