<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ site.description }}">
  <title>{{ title }} | {{ site.title }}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav>
      <a href="/" class="logo">{{ site.title }}</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <p>Data sourced from <a href="https://caltrans.maps.arcgis.com/">Caltrans Regional Bike Facilities</a></p>
    <p>&copy; {{ currentYear }} <a href="{{ site.url }}">Silicon Valley Bicycle Coalition</a></p>
  </footer>
</body>
</html>
