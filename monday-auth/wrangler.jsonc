{
  "name": "monday-auth",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  // The broker's /oauth/* routes are reached by a human in a browser (consent) and by Monday's
  // redirect, so it needs a public URL. Consumer Workers call it over service bindings instead.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monday-auth",
      // Placeholder until `wrangler d1 create monday-auth` runs (plan Task 6).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Proactive refresh, so a token never has to be refreshed on a consumer's request path.
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    // Set to the SVBC Integrations user id at cutover (plan step 0.4).
    "EXPECTED_USER_ID": "",
    "MONDAY_SUBDOMAIN": "bikesiliconvalley"
  },
  "observability": { "enabled": true, "issues": { "enabled": true } },

  "env": {
    "sandbox": {
      "name": "monday-auth-sandbox",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "monday-auth-sandbox",
          // Placeholder until `wrangler d1 create monday-auth-sandbox` runs (plan Task 6).
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["*/30 * * * *"] },
      "vars": {
        "ENVIRONMENT": "sandbox",
        // Sandbox Integration
        "EXPECTED_USER_ID": "117112617",
        "MONDAY_SUBDOMAIN": "bikesiliconvalley"
      },
      "observability": { "enabled": true, "issues": { "enabled": true } }
    }
  }
}
