{
  "name": "svbc-monday-auth",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  // The broker's /oauth/* routes are reached by a human in a browser (consent) and by Monday's
  // redirect, so it needs a public URL. Consumer Workers call it over service bindings instead.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-monday-auth",
      "database_id": "bafa2bf8-25b7-4bcb-8631-a946e6fe7d94",
      "migrations_dir": "migrations"
    }
  ],
  // Proactive refresh, so a token never has to be refreshed on a consumer's request path.
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "PROBE_ENABLED": "false",
    // The SVBC Integration user (created 2026-10-30); consent by anyone else is refused.
    "EXPECTED_USER_ID": "120827741",
    "MONDAY_SUBDOMAIN": "bikesiliconvalley"
  },
  // Attempt limiter for POST /oauth/* (keyed on CF-Connecting-IP), so START_KEY can't be guessed online (#104).
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2101", "simple": { "limit": 10, "period": 60 } }],
  // Workers Paid (this account's plan) defaults to 30s CPU/request; cap it far lower as a
  // guardrail against a runaway invocation or a surprise bill (#117). The broker's work is I/O
  // (D1, auth.monday.com) plus a SHA-256 or AES-GCM call, so 100 ms is ample.
  "limits": { "cpu_ms": 100 },
  "observability": { "enabled": true, "issues": { "enabled": true } },

  // Secrets (wrangler secret put, per environment): the three apps' client id/secret pairs,
  // START_KEY (at least 32 characters), TOKEN_ENC_KEY (AES-256-GCM key for the token columns in D1:
  // `openssl rand -base64 32`; set it BEFORE deploying a build that reads it) and optionally
  // SLACK_WEBHOOK_URL. See README.md.
  "env": {
    "sandbox": {
      "name": "svbc-monday-auth-sandbox",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-monday-auth-sandbox",
          "database_id": "810908bd-9f8e-4a19-baf9-ff7d373f962d",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["*/30 * * * *"] },
      "vars": {
        "ENVIRONMENT": "sandbox",
        // Off by default, like production; turn it on only while verifying (README "Measuring ... probe").
        "PROBE_ENABLED": "false",
        // Sandbox Integration
        "EXPECTED_USER_ID": "117112617",
        "MONDAY_SUBDOMAIN": "bikesiliconvalley"
      },
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2102", "simple": { "limit": 10, "period": 60 } }],
      "limits": { "cpu_ms": 100 },
      "observability": { "enabled": true, "issues": { "enabled": true } }
    }
  }
}
