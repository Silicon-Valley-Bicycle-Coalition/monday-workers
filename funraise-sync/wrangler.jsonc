{
  "name": "svbc-funraise-sync",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-funraise-sync",
      // Created 2026-09-18 on the SVBC account (wrangler d1 create svbc-funraise-sync); forks: create your own
      "database_id": "526c360c-0aa9-476d-af51-3de46b5e2f0b",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "funraise-sync-writes", "binding": "WRITE_QUEUE" }],
    "consumers": [
      {
        "queue": "funraise-sync-writes",
        "max_retries": 3,
        // Single consumer at a time — Monday's per-token complexity budget punishes
        // concurrent writers during a backlog drain.
        "max_concurrency": 1,
        "dead_letter_queue": "funraise-sync-writes-dlq"
      }
    ]
  },
  "triggers": {
    // Two jobs, dispatched by src/scheduled.ts on controller.cron — keep these in step with
    // POLL_CRON and PURGE_CRON there:
    //   "0 * * * *"  hourly Recurring Gifts ← Funraise subscriptions poll (spec 2026-09-18)
    //   "0 9 * * *"  daily raw_payload retention purge — window set by
    //                funraiseSync.rawPayloadRetentionDays in config/svbc.json
    "crons": ["0 * * * *", "0 9 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
