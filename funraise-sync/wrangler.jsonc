{
  "name": "svbc-funraise-sync",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "preview_urls": false,
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-funraise-sync",
      // Created 2026-09-18 on the SVBC account (wrangler d1 create svbc-funraise-sync); forks: create your own
      "database_id": "526c360c-0aa9-476d-af51-3de46b5e2f0b",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "funraise-sync-writes", "binding": "WRITE_QUEUE" }],
    "consumers": [
      {
        "queue": "funraise-sync-writes",
        // The consumer backs each retry off by attempt — 1 minute doubling to an hour
        // (retryDelaySeconds in src/flags.ts) — so 100 retries ride out about four days of
        // Monday outage (or a write-switch `hold` the queue pause missed) before dead-lettering.
        "max_retries": 100,
        // Floor for a retry that carries no delay of its own: a throw from queue() itself (a missing
        // secret, a config error, a CPU kill) redelivers the whole batch, and without this it would do
        // so at once and spend all 100 retries in minutes. Per-message retry({ delaySeconds }) overrides it.
        "retry_delay": 60,
        // Single consumer at a time — Monday's per-token complexity budget punishes
        // concurrent writers during a backlog drain.
        "max_concurrency": 1,
        "dead_letter_queue": "funraise-sync-writes-dlq"
      },
      {
        // #25: dead messages stamp their events row "dead-lettered after retries: …" and log one
        // error per batch (src/consumer/processDeadLetters.ts) instead of expiring unseen. Two D1
        // ops per message; no further dead-letter queue. Re-drive: scripts/redrive-failed.mjs.
        "queue": "funraise-sync-writes-dlq",
        "max_batch_size": 10,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  // Write-switch flags (scripts/flags.mjs). The namespace is `FLAGS` (`sandbox-FLAGS` under
  // env.sandbox); every in-scope Worker carries the same two ids, which
  // scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  // Traffic/cost guardrails — see README "Reliability: traffic and cost limits". 60/min/IP is
  // generous against real Funraise volume (a few hundred transactions a month) while blunting a
  // flood against the webhook route. The shared-secret check runs first in the route (before any
  // D1 or queue work), so the limiter bounds invocation count and cost, not bogus D1 writes.
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2031", "simple": { "limit": 60, "period": 60 } }],
  // Workers Paid (this account's plan) defaults to 30s CPU/request; cap it far lower as a
  // guardrail against a runaway invocation or a surprise bill. See the root README.
  "limits": { "cpu_ms": 100 },
  "triggers": {
    // Two jobs, dispatched by src/scheduled.ts on controller.cron — keep these in step with
    // POLL_CRON and PURGE_CRON there:
    //   "0 * * * *"  hourly Recurring Gifts ← Funraise subscriptions poll (spec 2026-09-18)
    //   "0 9 * * *"  daily raw_payload retention purge — window set by
    //                funraiseSync.rawPayloadRetentionDays in the selected config
    //                (config/svbc.json in production, config/sandbox.json in the sandbox)
    "crons": ["0 * * * *", "0 9 * * *"]
  },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  // Monday access: the monday-auth broker's Staff sync app (SyncToken entrypoint), which owns
  // the OAuth token and its refresh. src/monday/graphql.ts tokenProviderFor prefers this binding
  // over a MONDAY_API_TOKEN secret. Design: docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "SyncToken" }],
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-funraise-sync-sandbox
  // against the CRM Sandbox boards (config/sandbox.json, selected by the ENVIRONMENT var).
  // Everything here is non-inheritable in Wrangler and deliberately restated: the sandbox shares
  // nothing with production. Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — set the sandbox copies with `wrangler secret put <NAME> --env sandbox`
  // (FUNRAISE_WEBHOOK_SECRET, FUNRAISE_API_KEY for the subscriptions poll). Monday access comes
  // from the MONDAY_AUTH binding, not a MONDAY_API_TOKEN secret.
  "env": {
    "sandbox": {
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "sandbox" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-funraise-sync-sandbox",
          // Created 2026-09-19 on the SVBC account (wrangler d1 create svbc-funraise-sync-sandbox)
          "database_id": "2a4c4171-740b-4d09-a118-2ce055749d71",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "queue": "funraise-sync-writes-sandbox", "binding": "WRITE_QUEUE" }],
        "consumers": [
          {
            "queue": "funraise-sync-writes-sandbox",
            "max_retries": 100,
            "retry_delay": 60,
            "max_concurrency": 1,
            "dead_letter_queue": "funraise-sync-writes-sandbox-dlq"
          },
          {
            "queue": "funraise-sync-writes-sandbox-dlq",
            "max_batch_size": 10,
            "max_retries": 2,
            "max_concurrency": 1
          }
        ]
      },
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2032", "simple": { "limit": 60, "period": 60 } }],
      "limits": { "cpu_ms": 100 },
      "triggers": {
        // Same two jobs as production (the split test asserts they match).
        "crons": [] /* Sandbox crons disabled to save cost; run handlers manually when testing. */
      },
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      },
      // The sandbox broker, consented as Sandbox Integration.
      "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "SyncToken" }]
    }
  }
}
