{
  "monday": {
    "apiUrl": "https://api.monday.com/v2",
    "boards": {
      "donations:live": null,
      "recurring-gifts": null,
      "people-live": null
    }
  },
  "funraiseSync": {
    "columnMap": {
      "transaction.amount": "REPLACE_WITH_COLUMN_ID",
      "transaction.status": "REPLACE_WITH_COLUMN_ID",
      "donationDate": "REPLACE_WITH_COLUMN_ID"
    },
    "itemNameField": "description",
    "entityIdField": "id",
    "entityIdColumn": "REPLACE_WITH_COLUMN_ID",
    "thankYouSentColumn": "REPLACE_WITH_COLUMN_ID",
    "giftTypeColumn": "REPLACE_WITH_COLUMN_ID",
    "giftTypeValue": "Donation",
    "eventGiftTypeValue": "Event Ticket",
    "fiscalYearColumn": "REPLACE_WITH_COLUMN_ID",
    "recurringGiftLinkColumn": "REPLACE_WITH_COLUMN_ID",
    "rawPayloadRetentionDays": 90,
    "unresolvedPayloadRetentionDays": 365,
    "donorExternalIdField": "supporter.id",
    "donorExternalIdColumn": "REPLACE_WITH_COLUMN_ID",
    "donorEmailColumn": "REPLACE_WITH_COLUMN_ID",
    "donorNameField": "supporter.name",
    "donorLinkColumn": "REPLACE_WITH_COLUMN_ID",
    "emailFieldPrecedence": ["supporter.email"],
    "statusField": "transaction.status",
    "statusValueMap": {
      "Complete": "Received"
    },
    "doNotMigrateFields": [
      "transaction.lastFour",
      "transaction.expirationDate",
      "transaction.cardType",
      "transaction.billingFirstName",
      "transaction.billingLastName",
      "transaction.billingZip",
      "transaction.errors"
    ]
  },
  "subscriptionsPoll": {
    "enabled": true,
    "columns": {
      "funraiseId": "REPLACE_WITH_COLUMN_ID",
      "donor": "REPLACE_WITH_COLUMN_ID",
      "installmentAmount": "REPLACE_WITH_COLUMN_ID",
      "annualizedValue": "REPLACE_WITH_COLUMN_ID",
      "frequency": "REPLACE_WITH_COLUMN_ID",
      "status": "REPLACE_WITH_COLUMN_ID",
      "nextPayment": "REPLACE_WITH_COLUMN_ID",
      "designation": "REPLACE_WITH_COLUMN_ID",
      "companyMatch": "REPLACE_WITH_COLUMN_ID",
      "matchEmployer": "REPLACE_WITH_COLUMN_ID"
    },
    "frequencyMultiplier": { "Monthly": 12, "Quarterly": 4, "Yearly": 1 },
    "statusLabelMap": { "Active": "Active", "Cancelled": "Cancelled", "Failed": "Failed", "Redacted": "Redacted" },
    "funraiseLinkBase": "https://platform.funraise.io/transaction/",
    "maxPagesPerRun": 1
  }
}
