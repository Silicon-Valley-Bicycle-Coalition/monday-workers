{
  "name": "svbc-calendars",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-27",
  "upload_source_maps": true,
  // Public-facing — serve only on the custom domains, not *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "events.bikesiliconvalley.org", "custom_domain": true },
    { "pattern": "committees.bikesiliconvalley.org", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "CALENDAR_KV",
      // Created via `wrangler kv namespace create CALENDAR_KV` (2026-09-21).
      "id": "0fcbba8d6fbf464a8429149b65ffd989"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "CALENDAR_ANALYTICS",
      "dataset": "svbc_calendars"
    }
  ],
  // The Eventbrite private token and Slack webhook are secrets, NOT in this file:
  //   npx wrangler secret put EVENTBRITE_TOKEN
  //   npx wrangler secret put SLACK_WEBHOOK_URL
  "vars": {
    "EVENTBRITE_ORG_ID": "9974694499",
    "CACHE_TTL": "900", // /events, /widget — 15 min, unchanged from events-widgets
    "CALENDAR_CACHE_TTL": "86400", // /calendars/*.ics, /calendars — 24h, "nothing needs to be real-time"
    "CACHE_VERSION": "1", // reset to 1 for the new merged Worker's cache key space
    // Deliberately empty — permanently, not pending setup. bikesiliconvalley.org already has Web
    // Analytics on automatic setup (checked 2026-09-21), which injects the beacon into every
    // subdomain's pages with no code changes; a manual token here would just be a second,
    // redundant beacon. src/widget.ts and src/listing.ts only emit the beacon <script> when this
    // is truthy, so it stays empty rather than carrying a token that would double-count traffic.
    "CF_WEB_ANALYTICS_TOKEN": ""
  },
  "triggers": {
    // Daily at 13:00 UTC (5am/6am Pacific depending on DST), matching committee-calendars' prior schedule.
    "crons": ["0 13 * * *"]
  },
  // Traffic/cost guardrails — see README "Reliability: traffic and cost limits". 120/min/IP is
  // generous for a real visitor loading the widget/listing repeatedly, while blunting a bot
  // crawl or scraped-link flood against a Worker with no secret or auth of its own to gate abuse.
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2061", "simple": { "limit": 120, "period": 60 } }],
  // Free plan already hard-caps CPU at 10ms/request; this only starts to matter once the account
  // moves to Workers Paid (default 30s/request otherwise) — set now so the guardrail predates
  // that move rather than following a surprise bill.
  "limits": { "cpu_ms": 100 },
  "observability": {
    "enabled": true
  },
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // Unlike every other Worker's env.sandbox, this one has nothing to do with the CRM-migration
  // "inbound only, no outbound data" convention (docs/superpowers/specs/2026-09-18-sandbox-
  // environment-design.md explicitly lists svbc-calendars as out of scope there — no donor data,
  // not migration-related). This is a plain staging tier: a place to deploy and exercise changes
  // before they hit the real public domains, with its own KV/Analytics so test traffic can't
  // corrupt the real cache or skew real Web Analytics numbers. `wrangler deploy --env sandbox`
  // deploys svbc-calendars-sandbox.
  //
  // No staging subdomain exists for bikesiliconvalley.org, so this serves on its default
  // workers.dev URL rather than a custom domain.
  //
  // Secrets aren't in this file — set the sandbox copies separately:
  //   npx wrangler secret put EVENTBRITE_TOKEN --env sandbox   (same real token; public event
  //                                                              data, no sensitivity)
  //   npx wrangler secret put SLACK_WEBHOOK_URL --env sandbox  (optional — sendFailureAlert
  //                                                              no-ops without it, so leaving it
  //                                                              unset means test-triggered
  //                                                              failures don't page the real
  //                                                              ops channel)
  "env": {
    "sandbox": {
      "workers_dev": true,
      "preview_urls": false,
      // Explicit empty override — env.sandbox otherwise INHERITS the top-level `routes` (the
      // real custom domains) unless this is here. Learned this the hard way: the first sandbox
      // deploy, without this line, silently reassigned events.bikesiliconvalley.org and
      // committees.bikesiliconvalley.org away from whatever they were pointed at, straight to
      // the untested sandbox Worker. Never remove this line.
      "routes": [],
      "kv_namespaces": [
        {
          "binding": "CALENDAR_KV",
          // Created via `wrangler kv namespace create CALENDAR_KV --env sandbox` — separate from
          // production's so sandbox cache/last-known-good writes never collide with the real site.
          "id": "92501769bf324c409dfdbba8f47b44bf"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "CALENDAR_ANALYTICS",
          "dataset": "svbc_calendars_sandbox"
        }
      ],
      "vars": {
        "EVENTBRITE_ORG_ID": "9974694499",
        "CACHE_TTL": "900",
        "CALENDAR_CACHE_TTL": "86400",
        "CACHE_VERSION": "1",
        // Deliberately empty, same reasoning as production — see the top-level vars comment.
        // Left empty here permanently, not just pending setup: sandbox traffic shouldn't count
        // toward the real site's Web Analytics numbers at all.
        "CF_WEB_ANALYTICS_TOKEN": ""
      },
      "triggers": {
        "crons": ["0 13 * * *"]
      },
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2062", "simple": { "limit": 120, "period": 60 } }],
      "limits": { "cpu_ms": 100 },
      "observability": {
        "enabled": true
      }
    }
  }
}
