{
  "name": "svbc-calendars",
  "main": "src/worker.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  // Matches the deployed Worker (last deploy 2026-04-01); bump deliberately, with a redeploy.
  "compatibility_date": "2024-12-01",
  "upload_source_maps": true,
  // Public-facing — serve only on the custom domain, not *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "events.bikesiliconvalley.org",
      "custom_domain": true
    }
  ],
  // The Eventbrite private token is a secret, NOT in this file:
  //   npx wrangler secret put EVENTBRITE_TOKEN
  "vars": {
    "EVENTBRITE_ORG_ID": "9974694499",
    "CACHE_TTL": "900", // seconds (15 min). Tune higher if you like.
    "CACHE_VERSION": "5" // Bump to bust the edge cache on deploy.
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CALENDAR_KV",
      "id": "placeholder-replaced-in-task-16"
    }
  ]
}
