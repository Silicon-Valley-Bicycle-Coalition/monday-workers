{
  "name": "svbc-calendars",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker + Squarespace widget to display SVBC Eventbrite events",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "wrangler types --include-runtime=false && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "ics": "^3.12.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.2",
    "@cloudflare/workers-types": "^5.20260822.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
