{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "member-portal-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd member-portal && npm run dev:local"
      ],
      "port": 8787
    },
    {
      "name": "svbc-bike-lanes",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd svbc-bike-lanes && npx wrangler dev --port 8790"],
      "port": 8790
    },
    {
      "name": "status-page-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd status-page && npx wrangler dev --infer-origin-from-routes=false --port 8791"],
      "port": 8791
    }
  ]
}
