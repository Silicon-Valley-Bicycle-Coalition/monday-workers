{
  "name": "svbc-eventbrite-sync",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "preview_urls": false,
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-eventbrite-sync",
      // Created 2026-11-02 on the SVBC account (README "Deploy"); forks: create your own.
      "database_id": "212c9b84-a5b7-4b01-a9f2-0558b0d54849",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "eventbrite-sync-writes", "binding": "WRITE_QUEUE" }],
    "consumers": [
      {
        "queue": "eventbrite-sync-writes",
        // The consumer backs each retry off by attempt — 1 minute doubling to an hour
        // (retryDelaySeconds in src/flags.ts) — so 100 retries ride out about four days of
        // Monday outage (or a write-switch `hold` the queue pause missed) before dead-lettering.
        "max_retries": 100,
        // Floor for a retry that carries no delay of its own: a throw from queue() itself (a missing
        // secret, a config error, a CPU kill) redelivers the whole batch, and without this it would do
        // so at once and spend all 100 retries in minutes. Per-message retry({ delaySeconds }) overrides it.
        "retry_delay": 60,
        // Single consumer at a time — Monday's per-token complexity budget punishes
        // concurrent writers during a backlog drain (the backfill script is one).
        "max_concurrency": 1,
        "dead_letter_queue": "eventbrite-sync-writes-dlq"
      },
      {
        // Dead messages stamp their orders row "dead-lettered after retries: …" and log one
        // error per batch (src/consumer/processDeadLetters.ts) instead of expiring unseen. No
        // further dead-letter queue. Re-drive: scripts/backfill-orders.mjs for the affected event.
        "queue": "eventbrite-sync-writes-dlq",
        "max_batch_size": 10,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  // Write-switch flags (scripts/flags.mjs). The namespace is `FLAGS` (`sandbox-FLAGS` under
  // env.sandbox); every in-scope Worker carries the same two ids, which
  // scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  // Hourly for the ended-event sweep (src/endedEvents/sweep.ts). The daily missed-order check
  // (src/missedOrders/check.ts) shares it: the hour it runs at is decided in code (isCheckHour).
  "triggers": { "crons": ["0 * * * *"] },
  // Traffic/cost guardrails — see the root README "Reliability: traffic and cost limits". 60/min/IP
  // is generous against real Eventbrite volume (tens of orders a day at a Summit peak) while
  // blunting a flood against the webhook route. The shared-secret check runs first in the route
  // (before any D1 or queue work), so the limiter bounds invocation count and cost.
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2071", "simple": { "limit": 60, "period": 60 } }],
  // Workers Paid (this account's plan) defaults to 30s CPU/request; cap it far lower as a
  // guardrail against a runaway invocation or a surprise bill. See the root README.
  "limits": { "cpu_ms": 100 },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  // Monday access: the monday-auth broker's Staff sync app (SyncToken entrypoint), which owns
  // the OAuth token and its refresh. src/monday/graphql.ts tokenProviderFor prefers this binding
  // over a MONDAY_API_TOKEN secret. Design: docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  // No EMPLOYER_ANSWERS binding here yet: impact-attribution has never been deployed to production,
  // and a missing binding is the employer-answer hand-over switched off (spec "The binding is
  // optional", docs/superpowers/specs/2026-11-17-eventbrite-employer-answers-design.md). Add
  // { "binding": "EMPLOYER_ANSWERS", "service": "svbc-impact-attribution", "entrypoint": "EmployerAnswers" }
  // once it is.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "SyncToken" }],
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-eventbrite-sync-sandbox
  // against the CRM Sandbox boards (config/sandbox.json, selected by the ENVIRONMENT var).
  // Everything here is non-inheritable in Wrangler and deliberately restated: the sandbox shares
  // nothing with production. Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — set the sandbox copies with `wrangler secret put <NAME> --env sandbox`
  // (EVENTBRITE_PRIVATE_TOKEN, EVENTBRITE_WEBHOOK_SECRET). Monday access comes from the MONDAY_AUTH
  // binding, not a MONDAY_API_TOKEN secret.
  "env": {
    "sandbox": {
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "sandbox" },
      // Triggers are not inheritable either.
      "triggers": { "crons": [] /* Sandbox crons disabled to save cost; run handlers manually when testing. */ },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-eventbrite-sync-sandbox",
          "database_id": "b105e491-c9ef-49c4-ae0b-fe846214aa2f",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "queue": "eventbrite-sync-writes-sandbox", "binding": "WRITE_QUEUE" }],
        "consumers": [
          {
            "queue": "eventbrite-sync-writes-sandbox",
            "max_retries": 100,
            "retry_delay": 60,
            "max_concurrency": 1,
            "dead_letter_queue": "eventbrite-sync-writes-sandbox-dlq"
          },
          {
            "queue": "eventbrite-sync-writes-sandbox-dlq",
            "max_batch_size": 10,
            "max_retries": 2,
            "max_concurrency": 1
          }
        ]
      },
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2072", "simple": { "limit": 60, "period": 60 } }],
      "limits": { "cpu_ms": 100 },
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      },
      // The sandbox broker, consented as Sandbox Integration, and the sandbox impact-attribution's
      // EmployerAnswers RPC (#127), which employer answers are handed to.
      "services": [
        { "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "SyncToken" },
        { "binding": "EMPLOYER_ANSWERS", "service": "svbc-impact-attribution-sandbox", "entrypoint": "EmployerAnswers" }
      ]
    }
  }
}
