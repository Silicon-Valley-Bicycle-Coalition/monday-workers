{
  "name": "svbc-donor-portal",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  // Login portal — serve only on the custom domain, never *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-donor-portal",
      // Replace after running: wrangler d1 create svbc-donor-portal
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Requires `wrangler email sending enable mail.bikesiliconvalley.org` (see DEPLOY.md) before
  // first deploy — the "from" domain must be onboarded to Cloudflare Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [
      { "queue": "donor-portal-change-requests", "binding": "CHANGE_QUEUE" },
      { "queue": "donor-portal-letter-emails", "binding": "LETTER_SEND_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "donor-portal-change-requests",
        "max_retries": 3,
        // Single consumer at a time — Monday's per-token complexity budget punishes
        // concurrent writers during a backlog drain.
        "max_concurrency": 1,
        "dead_letter_queue": "donor-portal-change-requests-dlq"
      },
      {
        "queue": "donor-portal-letter-emails",
        "max_retries": 3,
        // Same reasoning as the change-requests consumer above.
        "max_concurrency": 1,
        "dead_letter_queue": "donor-portal-letter-emails-dlq"
      }
    ]
  },
  "triggers": {
    // Daily change_requests PII retention purge — window set by changeRequests.retentionDays
    // in config/svbc.json.
    "crons": ["0 9 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
