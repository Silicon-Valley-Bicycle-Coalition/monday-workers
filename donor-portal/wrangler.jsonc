{
  "name": "svbc-donor-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-donor-portal",
      // Replace after running: wrangler d1 create svbc-donor-portal
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "queues": {
    "producers": [{ "queue": "donor-portal-change-requests", "binding": "CHANGE_QUEUE" }],
    "consumers": [
      {
        "queue": "donor-portal-change-requests",
        "max_retries": 3,
        "dead_letter_queue": "donor-portal-change-requests-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
