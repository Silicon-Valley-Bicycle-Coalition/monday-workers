{
  "name": "svbc-donation-rollups",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "preview_urls": false,
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-donation-rollups",
      "database_id": "58bbaabb-acab-437a-9786-1e6a5cce256e",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "donation-rollups-recompute", "binding": "RECOMPUTE_QUEUE" }],
    "consumers": [
      {
        "queue": "donation-rollups-recompute",
        // The subrequest budget is per invocation and D1 queries count: a full recompute costs
        // ~16–26, plus up to 10 gift-term stamps (MAX_GIFT_TERM_WRITES_PER_RECOMPUTE) and ~3
        // Monday calls per affected affiliation in phase 2. On the Free plan's 50 that allowed a
        // batch of 2 (the default 10 produced the 2026-09-03 "Too many subrequests" failures);
        // on Workers Paid (cap 1,000) ten worst-case recomputes fit with room to spare. Messages
        // in a batch run one after another, so batch size only trims the gap between
        // invocations: ~10% throughput on sandbox v4 (2026-10-28), 12.8 → 14.2 owners/min.
        "max_batch_size": 10,
        // Every retry is delayed (retryDelaySeconds in src/flags.ts): 1 minute doubling to an
        // hour, so 100 retries ride out about four days of Monday outage (or a write-switch
        // `hold` the queue pause missed) before the DLQ. A D1 daily-quota error, or Monday's
        // daily limit, defers to midnight UTC (capped at Queues' 12h); a Monday rate limit waits
        // at least its retry hint.
        "max_retries": 100,
        // Floor for a retry that carries no delay of its own: a throw from queue() itself (a missing
        // secret, a config error, a CPU kill) redelivers the whole batch, and without this it would do
        // so at once and spend all 100 retries in minutes. Per-message retry({ delaySeconds }) overrides it.
        "retry_delay": 60,
        // Concurrency is the real throughput lever: a recompute is ~3 s of mostly Monday I/O.
        // Three consumers drained the sandbox v4 post-sweep backlog at 40.4 owners/min (vs 14.2
        // with one), per-owner time unchanged and 0 failures, so a full sweep of ~11,300 owners
        // takes ~4.7 h instead of ~15 h. Kept at 3, not higher, for Monday's per-token
        // complexity budget, which other Workers draw on during cutover (the sandbox run had
        // no other writers); rate-limit errors are retried with backoff (src/flags.ts), so going
        // over slows a drain rather than failing it. Two recomputes of one owner can now overlap
        // more often; the later write wins and the next pass re-converges (README, "Concurrent
        // gifts").
        "max_concurrency": 3,
        "dead_letter_queue": "donation-rollups-recompute-dlq"
      },
      {
        // Fix 5: dead messages mark their pending row failed and raise one alert per batch
        // (src/consumer/processDeadLetters.ts) instead of expiring unseen. Two D1 ops per
        // message, so a fuller batch is fine; no further dead-letter queue — after these
        // retries the row simply keeps its last consumer-recorded error.
        "queue": "donation-rollups-recompute-dlq",
        "max_batch_size": 10,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  // Write-switch flags (scripts/flags.mjs). The namespace is `FLAGS` (`sandbox-FLAGS` under
  // env.sandbox); every in-scope Worker carries the same two ids, which
  // scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  // Traffic/cost guardrails — see README "Reliability: traffic and cost limits". 60/min/IP
  // covers /custodian/* and every Monday webhook call that fails the secret check, blunting a
  // flood before it reaches D1. Verified webhook deliveries are exempt (issue #27): a bulk edit
  // makes Monday itself send well over 60/min from a few IPs (src/rateLimit.ts).
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2021", "simple": { "limit": 60, "period": 60 } }],
  // The fleet-wide 100ms cost cap (root README "Reliability: traffic and cost limits") does NOT
  // fit this Worker's nightly cron: the rollcall duty parses every People, People (Historical),
  // Organizations and active Donations item (~20k People alone) and computes the roll call in
  // the same invocation as reconcile, classify, membership and recurring. A CPU-limit kill is not
  // catchable — no custodian_runs row, no alert — so the cap would silently stop the night.
  // 30,000ms is Workers Paid's own default (300,000 is the maximum), roughly 10x the few seconds
  // that cron is expected to use; ruling R12 measures it in the sandbox run, and the dashboard's
  // per-Worker CPU-time metric is the place to tune it. CPU time excludes D1/Monday I/O wait, so
  // webhook and queue invocations still use a few ms each. Keep in step with env.sandbox below.
  "limits": { "cpu_ms": 30000 },
  // Daily custodian trigger at 09:00 UTC (≈ 2am Pacific) — src/custodian/custodian.ts's
  // dutiesForDate decides which duties today owes.
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  // Monday access: the monday-auth broker's Staff sync app (SyncToken entrypoint), which owns
  // the OAuth token and its refresh. src/monday/graphql.ts tokenProviderFor prefers this binding
  // over a MONDAY_API_TOKEN secret. Design: docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "SyncToken" }],
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-donation-rollups-sandbox
  // against the CRM Sandbox boards (config/sandbox.json, selected by the ENVIRONMENT var).
  // Everything here is non-inheritable in Wrangler and deliberately restated: the sandbox shares
  // nothing with production. The consumer settings mirror the top level — same subrequest and
  // D1-quota reasoning applies. Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — set the sandbox copies with `wrangler secret put <NAME> --env sandbox`
  // (MONDAY_WEBHOOK_SECRET, CUSTODIAN_SECRET). Monday access comes from the MONDAY_AUTH binding,
  // not a MONDAY_API_TOKEN secret.
  "env": {
    "sandbox": {
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "sandbox" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-donation-rollups-sandbox",
          // Created 2026-09-19 on the SVBC account (wrangler d1 create svbc-donation-rollups-sandbox)
          "database_id": "0d0663d9-b0dc-4a1c-b40b-6a6d020e034d",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "queue": "donation-rollups-recompute-sandbox", "binding": "RECOMPUTE_QUEUE" }],
        "consumers": [
          {
            "queue": "donation-rollups-recompute-sandbox",
            // Same as production; measured here (see the production consumer's comments).
            "max_batch_size": 10,
            "max_retries": 100,
            "retry_delay": 60,
            "max_concurrency": 3,
            "dead_letter_queue": "donation-rollups-recompute-sandbox-dlq"
          },
          {
            "queue": "donation-rollups-recompute-sandbox-dlq",
            "max_batch_size": 10,
            "max_retries": 2,
            "max_concurrency": 1
          }
        ]
      },
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2022", "simple": { "limit": 60, "period": 60 } }],
      // Same as the top-level limit: see its comment.
      "limits": { "cpu_ms": 30000 },
      "triggers": {
        "crons": ["0 9 * * *"]
      },
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      },
      // The sandbox broker, consented as Sandbox Integration.
      "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "SyncToken" }]
    }
  }
}
