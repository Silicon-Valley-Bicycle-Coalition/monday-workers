{
  "name": "svbc-donation-rollups",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-donation-rollups",
      "database_id": "58bbaabb-acab-437a-9786-1e6a5cce256e",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "donation-rollups-recompute", "binding": "RECOMPUTE_QUEUE" }],
    "consumers": [
      {
        "queue": "donation-rollups-recompute",
        // The Free plan's 50-subrequest budget is per invocation and D1 queries count: a full
        // recompute costs ~16–26 (more for owners with hundreds of gifts or pending gift-term
        // stamps), so the default batch of 10 is what produced the 2026-09-03 "Too many
        // subrequests" failures. Two worst-case recomputes fit; three don't. Throughput is
        // unchanged (max_concurrency is already 1). Raise this on Workers Paid (cap 1,000).
        //
        // Phase 2 (affiliation recompute) adds ~3 Monday calls per affected affiliation on top
        // of phase 1's ~5 per message; two messages per invocation keeps a bulk re-point under
        // the Free plan's 50-subrequest cap.
        "max_batch_size": 2,
        // Every retry is delayed (src/consumer/quota.ts): a D1 daily-quota error defers to
        // midnight UTC (capped at Queues' 12h), which with midnight up to 24h away can use two of
        // these three; a Monday rate-limit error waits 60s/120s/240s by attempt, or Monday's
        // retry hint if longer; any other transient error takes the same 60s/120s/240s (#35).
        "max_retries": 3,
        // Single consumer at a time — Monday's per-token complexity budget punishes
        // concurrent writers during a backlog drain (same reasoning as funraise-sync).
        "max_concurrency": 1,
        "dead_letter_queue": "donation-rollups-recompute-dlq"
      },
      {
        // Fix 5: dead messages mark their pending row failed and raise one alert per batch
        // (src/consumer/processDeadLetters.ts) instead of expiring unseen. Two D1 ops per
        // message, so a fuller batch is fine; no further dead-letter queue — after these
        // retries the row simply keeps its last consumer-recorded error.
        "queue": "donation-rollups-recompute-dlq",
        "max_batch_size": 10,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  // Traffic/cost guardrails — see README "Reliability: traffic and cost limits". 60/min/IP
  // covers /custodian/* and every Monday webhook call that fails the secret check, blunting a
  // flood before it reaches D1. Verified webhook deliveries are exempt (issue #27): a bulk edit
  // makes Monday itself send well over 60/min from a few IPs (src/rateLimit.ts).
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2021", "simple": { "limit": 60, "period": 60 } }],
  // Free plan already hard-caps CPU at 10ms/request; this only starts to matter once the account
  // moves to Workers Paid (default 30s/request otherwise) — set now so the guardrail predates
  // that move rather than following a surprise bill. CPU time excludes the D1/Monday I/O wait
  // this Worker's recompute batches are mostly made of, so this doesn't touch the
  // max_batch_size=2 subrequest tuning above.
  "limits": { "cpu_ms": 100 },
  // Daily custodian trigger at 09:00 UTC (≈ 2am Pacific) — src/custodian/custodian.ts's
  // dutiesForDate decides which duties today owes.
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-donation-rollups-sandbox
  // against the CRM Sandbox boards (config/sandbox.json, selected by the ENVIRONMENT var).
  // Everything here is non-inheritable in Wrangler and deliberately restated: the sandbox shares
  // nothing with production. The consumer settings mirror the top level — same subrequest and
  // D1-quota reasoning applies. Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — set the sandbox copies with `wrangler secret put <NAME> --env sandbox`
  // (MONDAY_API_TOKEN, MONDAY_WEBHOOK_SECRET).
  "env": {
    "sandbox": {
      "vars": { "ENVIRONMENT": "sandbox" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-donation-rollups-sandbox",
          // Created 2026-09-19 on the SVBC account (wrangler d1 create svbc-donation-rollups-sandbox)
          "database_id": "0d0663d9-b0dc-4a1c-b40b-6a6d020e034d",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "queue": "donation-rollups-recompute-sandbox", "binding": "RECOMPUTE_QUEUE" }],
        "consumers": [
          {
            "queue": "donation-rollups-recompute-sandbox",
            "max_batch_size": 2,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "donation-rollups-recompute-sandbox-dlq"
          },
          {
            "queue": "donation-rollups-recompute-sandbox-dlq",
            "max_batch_size": 10,
            "max_retries": 2,
            "max_concurrency": 1
          }
        ]
      },
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2022", "simple": { "limit": 60, "period": 60 } }],
      "limits": { "cpu_ms": 100 },
      "triggers": {
        "crons": ["0 9 * * *"]
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
