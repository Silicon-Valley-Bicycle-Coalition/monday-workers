{
  "access": {
    "teamDomain": "",
    "aud": "",
    "allowedEmailDomain": "bikesiliconvalley.org"
  },
  "timezone": "America/Los_Angeles",
  "feedTimeoutMs": 3000,
  "feedCacheSeconds": 60,
  "snapshotMaxAgeHours": 2,
  "syncs": [
    {
      "label": "Funraise donations → Monday",
      "description": "Online gifts from Funraise appear on the Donations board.",
      "worker": "funraise-sync",
      "queues": [
        "funraise-sync-writes"
      ]
    },
    {
      "label": "Eventbrite orders → Monday",
      "description": "Event ticket orders and refunds appear on the Donations board.",
      "worker": "eventbrite-sync",
      "queues": [
        "eventbrite-sync-writes"
      ]
    },
    {
      "label": "Mailchimp ↔ Monday",
      "description": "Subscribers, unsubscribes and member tags stay in step between Mailchimp and People.",
      "worker": "mailchimp-sync",
      "queues": [
        "mailchimp-sync-outbound",
        "mailchimp-sync-inbound"
      ]
    },
    {
      "label": "Benevity gifts → Monday",
      "description": "Uploaded Benevity workplace-giving reports become Donations items.",
      "worker": "benevity-import",
      "queues": [
        "benevity-import-writes"
      ]
    },
    {
      "label": "Giving totals on People",
      "description": "Lifetime giving and tier on each person update after a gift.",
      "worker": "donation-rollups",
      "queues": [
        "donation-rollups-recompute"
      ]
    },
    {
      "label": "Contact roles on People",
      "description": "The Contacts column on People is recomputed from their donations and roles.",
      "worker": "contact-roles",
      "queues": []
    },
    {
      "label": "Member and donor reclassification",
      "description": "People move between the live and historical boards as their status changes.",
      "worker": "people-reclassification",
      "queues": []
    },
    {
      "label": "Scheduled report emails",
      "description": "Weekly and daily report emails (recent gifts, renewals, unmatched gifts) go out.",
      "worker": "report-digests",
      "queues": []
    },
    {
      "label": "Monday backups",
      "description": "Nightly and hourly backups of the CRM boards are taken.",
      "worker": "monday-backup",
      "queues": []
    },
    {
      "label": "Member portal",
      "description": "Members can sign in, see their giving, and send change requests and letters.",
      "worker": "member-portal",
      "queues": [
        "member-portal-change-requests",
        "member-portal-letter-emails"
      ]
    },
    {
      "label": "Member map refresh",
      "description": "The staff member map refreshes its weekly snapshot.",
      "worker": "member-map",
      "queues": [
        "svbc-member-map-refresh"
      ]
    },
    {
      "label": "Bike Parking feedback emails",
      "description": "Bike Parking organizers get their feedback form link once staff mark an event ready.",
      "worker": "bp-feedback-notify",
      "queues": []
    },
    {
      "label": "Website event calendars",
      "description": "The events widget and committee calendars on bikesiliconvalley.org stay current.",
      "worker": "svbc-calendars",
      "queues": []
    }
  ],
  "hiddenWorkers": {
    "monday-auth": "plumbing; its failure shows as the syncs that depend on it"
  },
  "cloudflare": {
    "statusPageUrl": "https://www.cloudflarestatus.com",
