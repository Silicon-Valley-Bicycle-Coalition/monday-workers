{
  "name": "svbc-mailchimp-sync",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "preview_urls": false,
  "upload_source_maps": true,
  // Secrets (set with `wrangler secret put <NAME>`, never committed):
  //   MONDAY_API_TOKEN         — fallback only while the OAuth cutover is under way: Monday access
  //                              comes from the MONDAY_AUTH binding below (monday-auth broker)
  //   MAILCHIMP_API_KEY        — Mailchimp Marketing API key
  //   MONDAY_WEBHOOK_SECRET    — shared secret for the Monday webhook; the route fails closed
  //                              (401s everything) until it's set. Register the webhook as
  //                              https://<worker>/webhooks/monday/donors?secret=<MONDAY_WEBHOOK_SECRET>
  //                              — re-register the subscription if the secret changes.
  //   MAILCHIMP_WEBHOOK_SECRET — shared secret for the Mailchimp audience webhook; same
  //                              fail-closed behavior. Register as
  //                              https://<worker>/webhooks/mailchimp/audience?secret=<MAILCHIMP_WEBHOOK_SECRET>
  //   SLACK_WEBHOOK_URL        — OPTIONAL Slack incoming-webhook URL: one alert per dead-letter
  //                              batch (GL#37, src/alert.ts). Unset = log only (Workers Logs).
  // Write-switch flags (see ../scripts/flags.mjs): the shared KV namespace holding
  // `mailchimp-sync:writes` (on | hold | off; missing = off) and `mailchimp-sync:log`. The
  // namespace is `FLAGS` (`sandbox-FLAGS` under env.sandbox); every in-scope Worker carries the
  // same two ids, which scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-mailchimp-sync",
      "database_id": "af80fc24-f94e-4b6c-a4e1-64e48f0eac05",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "queue": "mailchimp-sync-outbound", "binding": "OUTBOUND_QUEUE" },
      { "queue": "mailchimp-sync-inbound", "binding": "INBOUND_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "mailchimp-sync-outbound",
        "max_retries": 100,
        // Floor for a retry that carries no delay of its own: a throw from queue() itself (a missing
        // secret, a config error, a CPU kill) redelivers the whole batch, and without this it would do
        // so at once and spend all 100 retries in minutes. Per-message retry({ delaySeconds }) overrides it.
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "mailchimp-sync-outbound-dlq"
      },
      {
        "queue": "mailchimp-sync-inbound",
        "max_retries": 100,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "mailchimp-sync-inbound-dlq"
      },
      // GL#37: dead messages stamp their pending row "dead-lettered after retries: …" and log one
      // error — and one Slack alert when SLACK_WEBHOOK_URL is set — per batch
      // (src/consumer/deadLetters.ts) instead of expiring
      // unseen. Two D1 ops per message; retried only when D1 fails, and no further dead-letter
      // queue — after these retries the row simply keeps its last consumer-recorded error.
      // Re-drive: scripts/redrive-dead-lettered.mjs. Retention is a CLI step, not config — see
      // README "Dead letters".
      {
        "queue": "mailchimp-sync-outbound-dlq",
        "max_batch_size": 10,
        "max_retries": 2,
        "max_concurrency": 1
      },
      {
        "queue": "mailchimp-sync-inbound-dlq",
        "max_batch_size": 10,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  // Traffic/cost guardrails — see README "Reliability: traffic and cost limits". 60/min/IP
  // covers both webhook routes, generous against real volume while blunting a flood against
  // routes that do D1 work before their shared-secret check ever rejects a bogus delivery.
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2041", "simple": { "limit": 60, "period": 60 } }],
  // Workers Paid (this account's plan) defaults to 30s CPU/request; cap it far lower as a
  // guardrail against a runaway invocation or a surprise bill. See the root README. 1000, not
  // 100: the hourly consent sync parses the whole Mailchimp audience (~61k members) and ~25k
  // Monday items per run (decided 2026-11-16; contact-roles and people-reclassification use 1000).
  "limits": { "cpu_ms": 1000 },
  "triggers": {
    // Once daily, 15:00 UTC = 8am Pacific (PDT) / 7am Pacific (PST) — Campaigns-board
    // reconciliation, see Task 10. Fire hour doesn't affect correctness. Hourly at :05 — the
    // consent column sync (src/consent/run.ts CONSENT_CRON; scheduled() dispatches on the string).
    "crons": ["0 15 * * *", "5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  // Monday access: the monday-auth broker's Staff sync app (SyncToken entrypoint), which owns
  // the OAuth token and its refresh. src/monday/graphql.ts tokenProviderFor prefers this binding
  // over a MONDAY_API_TOKEN secret. Design: docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "SyncToken" }],
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-mailchimp-sync-sandbox
  // against the CRM Sandbox People board and the *sandbox* Mailchimp audience named in
  // config/sandbox.json (selected by the ENVIRONMENT var). Rule: inbound data only, no outbound
  // data — the sandbox may only upsert into the sandbox audience; config/split.test.ts fails if
  // the two configs ever share an audience id. Everything here is non-inheritable in Wrangler and
  // deliberately restated. Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — `wrangler secret put <NAME> --env sandbox` for
  // MAILCHIMP_API_KEY (may be the same account key), MONDAY_WEBHOOK_SECRET, MAILCHIMP_WEBHOOK_SECRET,
  // and the optional SLACK_WEBHOOK_URL (point it at a sandbox channel, never production's).
  "env": {
    "sandbox": {
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "sandbox" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-mailchimp-sync-sandbox",
          "database_id": "12d8cae3-159d-47d0-a6e4-d2deb459a627",
          "migrations_dir": "migrations"
        }
      ],
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "queues": {
        "producers": [
          { "queue": "mailchimp-sync-outbound-sandbox", "binding": "OUTBOUND_QUEUE" },
          { "queue": "mailchimp-sync-inbound-sandbox", "binding": "INBOUND_QUEUE" }
        ],
        "consumers": [
          {
            "queue": "mailchimp-sync-outbound-sandbox",
            "max_retries": 100,
            "retry_delay": 60,
            "max_concurrency": 1,
            "dead_letter_queue": "mailchimp-sync-outbound-sandbox-dlq"
          },
          {
            "queue": "mailchimp-sync-inbound-sandbox",
            "max_retries": 100,
            "retry_delay": 60,
            "max_concurrency": 1,
            "dead_letter_queue": "mailchimp-sync-inbound-sandbox-dlq"
          },
          // Restated from the top level (named envs don't inherit queues) — see GL#37 above.
          {
            "queue": "mailchimp-sync-outbound-sandbox-dlq",
            "max_batch_size": 10,
            "max_retries": 2,
            "max_concurrency": 1
          },
          {
            "queue": "mailchimp-sync-inbound-sandbox-dlq",
            "max_batch_size": 10,
            "max_retries": 2,
            "max_concurrency": 1
          }
        ]
      },
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2042", "simple": { "limit": 60, "period": 60 } }],
      "limits": { "cpu_ms": 1000 },
      "triggers": {
        "crons": [] /* Sandbox crons disabled to save cost; run handlers manually when testing. */
      },
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      },
      // The sandbox broker, consented as Sandbox Integration.
      "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "SyncToken" }]
    }
  }
}
