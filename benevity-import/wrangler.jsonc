{
  "name": "svbc-benevity-import",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-benevity-import",
      "database_id": "0f52790b-9707-4160-9cbf-54e8a560198e",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "benevity-import-writes", "binding": "WRITE_QUEUE" }],
    "consumers": [
      {
        "queue": "benevity-import-writes",
        // Retries back off 1 minute doubling to an hour (retryDelaySeconds in src/flags.ts), so
        // 100 retries ride out about four days of Monday outage (or a write-switch `hold` the
        // queue pause missed) before dead-lettering.
        "max_retries": 100,
        // Floor for a retry that carries no delay of its own: a throw from queue() itself (a missing
        // secret, a config error, a CPU kill) redelivers the whole batch, and without this it would do
        // so at once and spend all 100 retries in minutes. Per-message retry({ delaySeconds }) overrides it.
        "retry_delay": 60,
        // Single consumer at a time — Monday's per-token complexity budget punishes
        // concurrent writers during a backlog drain (same reasoning as funraise-sync).
        "max_concurrency": 1,
        "dead_letter_queue": "benevity-import-writes-dlq"
      },
      // #60: a dead message marks its row needs-review ("dead-lettered after retries: …") and
      // raises a Benevity Uploads worklist item for it, which a staff Retry re-queues
      // (src/consumer/deadLetters.ts) — instead of expiring unseen. Retried only when D1 fails,
      // with no further dead-letter queue. The worklist post is skipped unless writes are `on`
      // and never retried here; the daily cron's sweep posts any that are missing.
      {
        "queue": "benevity-import-writes-dlq",
        "max_batch_size": 10,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  // Write-switch flags (scripts/flags.mjs). The namespace is `FLAGS` (`sandbox-FLAGS` under
  // env.sandbox); every in-scope Worker carries the same two ids, which
  // scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  // Traffic/cost guardrails — see README "Reliability: traffic and cost limits". 60/min/IP is
  // generous against real Benevity volume (occasional CSV-triggered uploads) while blunting a
  // flood against the webhook route, which does D1 work before the shared-secret check ever
  // rejects a bogus delivery.
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } }],
  // Workers Paid (this account's plan) defaults to 30s CPU/request; cap it far lower as a
  // guardrail against a runaway invocation or a surprise bill. See the root README.
  "limits": { "cpu_ms": 100 },
  "triggers": {
    // Daily raw_row retention purge — window set by benevityImport.rawRowRetentionDays / unresolvedRowRetentionDays —
    // then, while writes are `on`, the dead-letter worklist sweep (#60).
    "crons": ["15 9 * * *"]
  },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },

  // Monday access: the monday-auth broker's Staff sync app (SyncToken entrypoint), which owns
  // the OAuth token and its refresh. src/monday/graphql.ts tokenProviderFor prefers this binding
  // over a MONDAY_API_TOKEN secret. Design: docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "SyncToken" }],
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-benevity-import-sandbox
  // against the CRM Sandbox boards (config/sandbox.json, selected by the ENVIRONMENT var). This
  // Worker writes only to Monday, so the split exists so sandbox and production can coexist.
  // Everything here is non-inheritable in Wrangler and deliberately restated.
  // Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — `wrangler secret put <NAME> --env sandbox` for BENEVITY_WEBHOOK_SECRET.
  // Monday access comes from the MONDAY_AUTH binding, not a MONDAY_API_TOKEN secret.
  "env": {
    "sandbox": {
      "vars": { "ENVIRONMENT": "sandbox" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-benevity-import-sandbox",
          // Created 2026-09-19 on the SVBC account (wrangler d1 create svbc-benevity-import-sandbox); forks: create your own
          "database_id": "e71ba272-31f4-41d1-ae35-6a5c8a108631",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "queue": "benevity-import-writes-sandbox", "binding": "WRITE_QUEUE" }],
        "consumers": [
          {
            "queue": "benevity-import-writes-sandbox",
            "max_retries": 100,
            "retry_delay": 60,
            "max_concurrency": 1,
            "dead_letter_queue": "benevity-import-writes-sandbox-dlq"
          },
          {
            "queue": "benevity-import-writes-sandbox-dlq",
            "max_batch_size": 10,
            "max_retries": 2,
            "max_concurrency": 1
          }
        ]
      },
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }],
      "limits": { "cpu_ms": 100 },
      "triggers": {
        "crons": ["15 9 * * *"]
      },
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      },
      // The sandbox broker, consented as Sandbox Integration.
      "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "SyncToken" }]
    }
  }
}
