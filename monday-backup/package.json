{
  "name": "monday-backup",
  "version": "0.1.0",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev",
    "dev:sandbox": "wrangler dev --env sandbox",
    "deploy": "wrangler deploy",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "typecheck": "wrangler types --include-runtime=false && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "restore": "tsx scripts/restore.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
