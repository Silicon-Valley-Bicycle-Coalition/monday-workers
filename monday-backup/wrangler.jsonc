{
  "name": "svbc-monday-backup",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  // Cron-only — no routes, and workers_dev/preview_urls stay false. Nothing about a backup
  // Worker should be reachable from the Internet; it only makes outbound calls.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-monday-backup",
      "database_id": "8f9de9e4-227c-4e8d-b27d-c158948a8a5e",
      "migrations_dir": "migrations"
    }
  ],
  // Write-switch flags (scripts/flags.mjs). The namespace is `FLAGS` (`sandbox-FLAGS` under
  // env.sandbox); every in-scope Worker carries the same two ids, which
  // scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  // The snapshot itself: one step per board or doc (src/workflow.ts). A complete run takes about an
  // hour, which no single cron invocation gets. Trigger one by hand with
  // `npx wrangler workflows trigger svbc-monday-backup-snapshot`.
  "workflows": [{ "name": "svbc-monday-backup-snapshot", "binding": "SNAPSHOT", "class_name": "SnapshotWorkflow" }],
  "triggers": {
    // Daily at 09:00 UTC (1am/2am Pacific depending on DST) — after Monday's own nightly
    // processing settles, well before SVBC staff start their day. Adjust if a different
    // time is preferred once this is actually scheduled.
    // This only starts the Workflow. Second entry: the hourly staleness watchdog (src/watchdog.ts,
    // issue #29) — alerts when a run died mid-flight (row stuck 'running' > 12h) or no complete
    // snapshot landed in 36h.
    // Keep in sync with BACKUP_CRON / WATCHDOG_CRON in src/index.ts (index.test.ts checks).
    "crons": ["0 9 * * *", "30 * * * *"]
  },
  // The fleet-wide 100ms cost cap (root README "Reliability: traffic and cost limits") does NOT
  // fit this Worker — issue #29. A full-account snapshot parses and re-serializes megabytes of
  // Monday JSON and RS256-signs a Google JWT; at 100ms the runtime kills the invocation, which is
  // not a catchable exception (no D1 finish row, no alert). 300,000ms (5 min) is the maximum
  // `cpu_ms` accepts, and these limits also apply to the Workflow's steps, which have no wall-time
  // cap. Subrequests: every Monday page, Drive upload chunk and D1 call counts; a full run makes
  // roughly 3,000, and 50,000 leaves ample headroom over the 10,000 Paid default. Requires Workers Paid — Free caps crons at 10ms CPU / 50 subrequests,
  // which no real snapshot fits in.
  "limits": { "cpu_ms": 300000, "subrequests": 50000 },
  "observability": { "enabled": true, "issues": { "enabled": true } },

  // Monday access: the monday-auth broker's Read-only app (ReadOnlyToken entrypoint), which owns
  // the OAuth token and its refresh. src/monday/graphql.ts tokenProviderFor prefers this binding
  // over a MONDAY_API_TOKEN secret. Design: docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "ReadOnlyToken" }],
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-monday-backup-sandbox,
  // which snapshots every board its *sandbox* token can see (a user scoped to the CRM Sandbox
  // workspace) into the Drive folder named in config/backup.sandbox.json, alerting a sandbox
  // Slack channel. Rule: inbound data only, no outbound data — the Drive folder and Slack channel
  // are staff-only sinks, and config/split.test.ts fails if the two configs ever share the folder.
  // Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — `wrangler secret put <NAME> --env sandbox` for
  // GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY (a service account shared only
  // into the sandbox folder), SLACK_WEBHOOK_URL (#crm-sandbox).
  // Monday access comes from the MONDAY_AUTH binding (the sandbox broker, consented as the
  // sandbox-workspace-scoped Sandbox Integration user), not a MONDAY_API_TOKEN secret.
  "env": {
    "sandbox": {
      "vars": { "ENVIRONMENT": "sandbox" },
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-monday-backup-sandbox",
          "database_id": "f3dc73a0-bf23-488f-b810-f26e79dad6f5",
          "migrations_dir": "migrations"
        }
      ],
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "workflows": [{ "name": "svbc-monday-backup-snapshot-sandbox", "binding": "SNAPSHOT", "class_name": "SnapshotWorkflow" }],
      "triggers": {
        "crons": ["0 9 * * *", "30 * * * *"]
      },
      "limits": { "cpu_ms": 300000, "subrequests": 50000 },
      "observability": { "enabled": true, "issues": { "enabled": true } },
      // The sandbox broker, consented as Sandbox Integration.
      "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "ReadOnlyToken" }]
    }
  }
}
