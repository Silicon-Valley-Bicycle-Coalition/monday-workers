# Secrets for operator scripts and CLIs run from a laptop, one file per environment:
#   .env.production   real SVBC workspace
#   .env.sandbox      sandbox workspace
# Both are gitignored. This template is the only tracked copy, so keep real values out of it.
#
# These files don't configure deployed Workers. Workers get secrets from `wrangler secret put` and
# Monday tokens from the monday-auth broker. scripts/flags.mjs needs nothing here either: it reuses
# wrangler's own login.
#
# Loading (a variable already set in your shell wins over the file):
#   node --env-file=.env.sandbox scripts/check-monday-token-scope.mjs --workspace <id>
#   cd donation-rollups && node --env-file=../.env.sandbox scripts/setup-webhooks.mjs ...
#   cd salesforce-import && DOTENV_CONFIG_PATH=../.env.sandbox npm run cli -- validate
#     (salesforce-import loads dotenv, which otherwise reads only its own .env)
#
# A gitignored file is deleted along with its worktree. Copy these out before `git worktree remove`.

# --- Monday.com ---

# The integration user's token for this environment: SVBC Integration in production, Sandbox
# Integration in the sandbox. Never a staff member's personal token.
# Used by Worker setup scripts, scripts/, salesforce-import, geo-filter and monday-backup restore.
MONDAY_API_TOKEN=

# salesforce-import `configure --only dashboards`. The integration user gets a 403 creating
# dashboards, so this is a token for a user who is allowed to. Blank falls back to MONDAY_API_TOKEN.
MONDAY_DASHBOARD_TOKEN=

# --- Google ---

# salesforce-import geocode and enrich stages.
GOOGLE_MAPS_API_KEY=

# --- Eventbrite ---

# eventbrite-sync backfill-attendees, backfill-orders and pledge-event-config.
EVENTBRITE_PRIVATE_TOKEN=

# eventbrite-sync backfill-attendees and backfill-orders. Must match the value the Worker holds.
EVENTBRITE_WEBHOOK_SECRET=

# --- Funraise ---

# funraise-sync redrive-failed and replay-window. Must match the value the Worker holds.
FUNRAISE_WEBHOOK_SECRET=

# --- Mailchimp ---

# mailchimp-sync redrive-dead-lettered, inbound direction. Must match the value the Worker holds.
MAILCHIMP_WEBHOOK_SECRET=

# --- Set per command, not here ---
# Each of these names means a different Worker's secret depending on the script, so one saved value
# would be wrong for the others. Pass it inline for the one run:
#   WEBHOOK_SECRET=... node --env-file=../.env.sandbox scripts/setup-webhooks.mjs ...
#
# WEBHOOK_SECRET
#   donation-rollups setup-webhooks: that Worker's MONDAY_WEBHOOK_SECRET
#   people-reclassification setup-promote: that Worker's PROMOTE_WEBHOOK_SECRET
# MONDAY_WEBHOOK_SECRET
#   donation-rollups redrive-pending: that Worker's MONDAY_WEBHOOK_SECRET
#   mailchimp-sync redrive-dead-lettered, outbound direction: that Worker's MONDAY_WEBHOOK_SECRET
