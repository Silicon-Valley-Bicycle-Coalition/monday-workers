{
  "name": "svbc-quickbooks-sync",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  // Secrets (set with `wrangler secret put <NAME>`, never committed):
  //   MONDAY_API_TOKEN          — Monday API token (dedicated integration user, least-privilege)
  //   QB_CLIENT_ID              — QuickBooks OAuth2 app client id
  //   QB_CLIENT_SECRET          — QuickBooks OAuth2 app client secret
  //   QB_WEBHOOK_VERIFIER_TOKEN — QuickBooks webhook verifier token (HMAC signature check)
  //   MONDAY_WEBHOOK_SECRET     — shared secret for the Monday webhook; the route fails closed
  //                               (401s everything) until it's set. The Monday webhook
  //                               subscription URL must include it: register the webhook as
  //                               https://<worker>/webhooks/monday?secret=<MONDAY_WEBHOOK_SECRET>
  //                               — re-register the subscription if the secret changes.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-quickbooks-sync",
      // Replace after running: wrangler d1 create svbc-quickbooks-sync
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "quickbooks-sync-writes", "binding": "SYNC_QUEUE" }],
    "consumers": [
      {
        "queue": "quickbooks-sync-writes",
        "max_retries": 3,
        // Single consumer at a time — Monday's per-token complexity budget punishes
        // concurrent writers during a backlog drain.
        "max_concurrency": 1,
        "dead_letter_queue": "quickbooks-sync-writes-dlq"
      }
    ]
  },
  // Traffic/cost guardrails — see README "Reliability: traffic and cost limits". 60/min/IP
  // covers both webhook routes, generous against real volume while blunting a flood against
  // routes that do D1 work before their signature/secret check ever rejects a bogus request.
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2051", "simple": { "limit": 60, "period": 60 } }],
  // Free plan already hard-caps CPU at 10ms/request; this only starts to matter once the account
  // moves to Workers Paid (default 30s/request otherwise) — set now so the guardrail predates
  // that move rather than following a surprise bill.
  "limits": { "cpu_ms": 100 },
  "observability": {
    "enabled": true
  },
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-quickbooks-sync-sandbox
  // against Intuit's *sandbox* host (config/sandbox.json quickbooks.apiBaseUrl, selected by the
  // ENVIRONMENT var) with the sandbox app's development keys. Rule: inbound data only, no
  // outbound data — a sandbox deploy can only create Customers in the sandbox company, and
  // config/split.test.ts fails if the two configs ever share the host. Everything here is
  // non-inheritable in Wrangler and deliberately restated.
  // Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — `wrangler secret put <NAME> --env sandbox` for MONDAY_API_TOKEN,
  // QB_CLIENT_ID and QB_CLIENT_SECRET (the sandbox app's *development* keys — production keys
  // are refused by the sandbox host), QB_WEBHOOK_VERIFIER_TOKEN, MONDAY_WEBHOOK_SECRET.
  "env": {
    "sandbox": {
      "vars": { "ENVIRONMENT": "sandbox" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-quickbooks-sync-sandbox",
          "database_id": "4f814e75-a35d-4b29-9370-e215fb5315bb",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "queue": "quickbooks-sync-writes-sandbox", "binding": "SYNC_QUEUE" }],
        "consumers": [
          {
            "queue": "quickbooks-sync-writes-sandbox",
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "quickbooks-sync-writes-sandbox-dlq"
          }
        ]
      },
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2052", "simple": { "limit": 60, "period": 60 } }],
      "limits": { "cpu_ms": 100 },
      "observability": {
        "enabled": true
      }
    }
  }
}
