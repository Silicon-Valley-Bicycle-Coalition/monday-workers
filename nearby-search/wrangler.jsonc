{
  "name": "svbc-nearby-search",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  "workers_dev": false, // served on a custom domain behind one Access application, never workers.dev
  // Provision once, then paste the ids: `wrangler d1 create svbc-nearby-search`,
  // `wrangler queues create nearby-search-writes` and `nearby-search-writes-dlq`, then
  // `wrangler d1 migrations apply svbc-nearby-search --remote`. Until then database_id is a placeholder.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-nearby-search",
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  // Confirming a search enqueues one message per match; the consumer writes the results-board rows
  // and the Nearby connect column. Same outage-tolerant retry policy as every queue Worker (root
  // CLAUDE.md): max_retries 100 on the main queue, retention set by scripts/flags.mjs.
  "queues": {
    "producers": [{ "queue": "nearby-search-writes", "binding": "WRITES" }],
    "consumers": [
      {
        "queue": "nearby-search-writes",
        "max_batch_size": 10,
        "max_retries": 100,
        "max_concurrency": 1,
        "dead_letter_queue": "nearby-search-writes-dlq"
      },
      {
        "queue": "nearby-search-writes-dlq",
        "max_batch_size": 10,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  // Write-switch flags (scripts/flags.mjs): every Monday write is gated on `nearby-search:writes`.
  // The namespace is `FLAGS` (`sandbox-FLAGS` under env.sandbox); every in-scope Worker carries the
  // same two ids, which scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  // Traffic/cost guardrails — see the root README "Reliability: traffic and cost limits".
  "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2093", "simple": { "limit": 60, "period": 60 } }],
  // Searches run a turf buffer/point-in-polygon pass over a few tens of thousands of contacts.
  "limits": { "cpu_ms": 2000 },
  // Hourly (minute 17 to stay off the top of the hour): geocodes People/Organizations that have an
  // address but no Lat/Lng yet, a bounded batch per run.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  // Monday access: the monday-auth broker's Staff sync app (SyncToken entrypoint), which owns the
  // OAuth token and its refresh — this Worker writes. Design:
  // docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "SyncToken" }],
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-nearby-search-sandbox
  // against the CRM Sandbox boards (config/sandbox.json, selected by the ENVIRONMENT var). Inbound
  // data only: this Worker emits nothing outside Monday; the OSM lookups send an address or street
  // name, never a contact. Same convention as member-portal — see
  // docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  "env": {
    "sandbox": {
      "vars": { "ENVIRONMENT": "sandbox" },
      "workers_dev": false, // served on a custom domain behind one Access application, never workers.dev
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-nearby-search-sandbox",
          "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "queue": "nearby-search-writes-sandbox", "binding": "WRITES" }],
        "consumers": [
          {
            "queue": "nearby-search-writes-sandbox",
            "max_batch_size": 10,
            "max_retries": 100,
            "max_concurrency": 1,
            "dead_letter_queue": "nearby-search-writes-sandbox-dlq"
          },
          {
            "queue": "nearby-search-writes-sandbox-dlq",
            "max_batch_size": 10,
            "max_retries": 2,
            "max_concurrency": 1
          }
        ]
      },
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "ratelimits": [{ "name": "REQUEST_RATE_LIMITER", "namespace_id": "2094", "simple": { "limit": 60, "period": 60 } }],
      "limits": { "cpu_ms": 2000 },
      "triggers": {
        "crons": ["17 * * * *"]
      },
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      },
      // The sandbox broker, consented as Sandbox Integration.
      "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "SyncToken" }]
    }
  }
}
