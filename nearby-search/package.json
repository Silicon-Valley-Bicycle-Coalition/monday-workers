{
  "name": "nearby-search",
  "version": "0.1.0",
  "description": "Staff-only search for People, People (Historical) and Organizations near an address or road segment (OpenStreetMap), shown on a map; confirming queues the matches onto a results board in Monday.",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev",
    "dev:sandbox": "wrangler dev --env sandbox",
    "deploy": "wrangler deploy",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "typecheck": "wrangler types --include-runtime=false && tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/geojson": "^7946.0.16",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
