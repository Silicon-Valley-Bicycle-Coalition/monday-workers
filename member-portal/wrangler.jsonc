{
  "name": "svbc-member-portal",
  "main": "src/index.ts",
  "account_id": "f323cb191edeb5d30acc4d289427a010", // SVBC Account — forks: replace with your own
  "compatibility_date": "2026-08-01",
  "upload_source_maps": true,
  // Login portal — serve only on the custom domain, never *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "member.bikesiliconvalley.org", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svbc-member-portal",
      "database_id": "de5bdf9d-d1fd-4f8c-aeb5-d49df43a6c41",
      "migrations_dir": "migrations"
    }
  ],
  // Write-switch flags (scripts/flags.mjs). The namespace is `FLAGS` (`sandbox-FLAGS` under
  // env.sandbox); every in-scope Worker carries the same two ids, which
  // scripts/check-worker-flags.mjs verifies.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "1dec1f10ebcc41e7a464179ba2b37628" }],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    // Blanket per-IP guard covering every route (including /webhooks/monday/letters, which had
    // no limit before this) — see README "Reliability: traffic and cost limits". Coarser than,
    // and in addition to, LOGIN_RATE_LIMITER above.
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Workers Paid (this account's plan) defaults to 30s CPU/request; cap it far lower as a
  // guardrail against a runaway invocation or a surprise bill. See the root README.
  "limits": { "cpu_ms": 100 },
  // Requires `wrangler email sending enable mail.bikesiliconvalley.org` (see DEPLOY.md) before
  // first deploy — the "from" domain must be onboarded to Cloudflare Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [
      { "queue": "member-portal-change-requests", "binding": "CHANGE_QUEUE" },
      { "queue": "member-portal-letter-emails", "binding": "LETTER_SEND_QUEUE" }
    ],
    // Only the letter-emails consumer lives here. The change-requests consumer moved to
    // member-portal-writer (wrangler.writer.jsonc): this Worker is read-only on Monday.
    "consumers": [
      {
        "queue": "member-portal-letter-emails",
        "max_retries": 100,
        // Floor for a retry that carries no delay of its own: a throw from queue() itself (a missing
        // secret, a config error, a CPU kill) redelivers the whole batch, and without this it would do
        // so at once and spend all 100 retries in minutes. Per-message retry({ delaySeconds }) overrides it.
        "retry_delay": 60,
        // Same reasoning as the change-requests consumer above.
        "max_concurrency": 1,
        "dead_letter_queue": "member-portal-letter-emails-dlq"
      }
    ]
  },
  // Monday access: the monday-auth broker's PortalToken entrypoint (read-only scope), so this
  // Worker can read boards but never write them; change requests are written by
  // member-portal-writer with SyncToken. src/monday/graphql.ts tokenProviderFor prefers this
  // binding over a MONDAY_API_TOKEN secret. Design: docs/superpowers/specs/2026-10-30-monday-oauth-broker-design.md.
  "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth", "entrypoint": "PortalToken" }],
  "triggers": {
    // Daily run: change_requests/card_tokens retention purges, plus the automatic January
    // letter-email check (runLetterCron — a no-op unless the Letter Settings board arms it;
    // see README v2.3).
    "crons": ["0 9 * * *"]
  },
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  // ── Sandbox environment ───────────────────────────────────────────────────────────────────
  // `wrangler deploy --env sandbox` (npm run deploy:sandbox) deploys svbc-member-portal-sandbox
  // against the CRM Sandbox boards (config/sandbox.json, selected by the ENVIRONMENT var).
  // Rule: inbound data only, no outbound data — the EMAIL binding below may only deliver to the
  // one sink address, enforced by Cloudflare (E_RECIPIENT_NOT_ALLOWED otherwise); the code
  // layer in src/email/sandboxBinding.ts rewrites recipients to the same address. Everything
  // here is non-inheritable in Wrangler and deliberately restated: the sandbox shares nothing
  // with production. Design: docs/superpowers/specs/2026-09-18-sandbox-environment-design.md.
  // Secrets exist twice — set the sandbox copies with `wrangler secret put <NAME> --env sandbox`
  // (LETTER_WEBHOOK_SECRET). Monday access comes from the MONDAY_AUTH binding, not a MONDAY_API_TOKEN secret.
  "env": {
    "sandbox": {
      "vars": {
        "ENVIRONMENT": "sandbox",
        // Must equal allowed_destination_addresses[0] below — config/split.test.ts checks.
        "SANDBOX_EMAIL_SINK": "sandbox@bikesiliconvalley.org"
      },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "member.sandbox.bikesiliconvalley.org", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "svbc-member-portal-sandbox",
          "database_id": "490a0d98-e168-46eb-a4ee-ef28ecf92043",
          "migrations_dir": "migrations"
        }
      ],
      // The sandbox-FLAGS namespace.
      "kv_namespaces": [{ "binding": "FLAGS", "id": "a80c21a348064e07bb9c1bff16bee1a4" }],
      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "REQUEST_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "limits": { "cpu_ms": 100 },
      "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["sandbox@bikesiliconvalley.org"] }],
      "queues": {
        "producers": [
          { "queue": "member-portal-change-requests-sandbox", "binding": "CHANGE_QUEUE" },
          { "queue": "member-portal-letter-emails-sandbox", "binding": "LETTER_SEND_QUEUE" }
        ],
        // Letter-emails only; the change-requests consumer is member-portal-writer-sandbox.
        "consumers": [
          {
            "queue": "member-portal-letter-emails-sandbox",
            "max_retries": 100,
            "retry_delay": 60,
            "max_concurrency": 1,
            "dead_letter_queue": "member-portal-letter-emails-sandbox-dlq"
          }
        ]
      },
      "triggers": {
        "crons": ["0 9 * * *"]
      },
      // The sandbox broker, consented as Sandbox Integration.
      "services": [{ "binding": "MONDAY_AUTH", "service": "svbc-monday-auth-sandbox", "entrypoint": "PortalToken" }],
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      }
    }
  }
}
