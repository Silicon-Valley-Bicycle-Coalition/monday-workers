{
  "name": "member-portal",
  "version": "0.1.0",
  "description": "Public-facing donor self-service portal: donation history and membership/discount benefits via passwordless email login.",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev",
    "dev:sandbox": "wrangler dev --env sandbox",
    "predev:local": "wrangler d1 migrations apply svbc-member-portal-local --local --config wrangler.local.jsonc",
    "dev:local": "wrangler dev --config wrangler.local.jsonc",
    "deploy": "wrangler deploy",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "deploy:writer": "wrangler deploy -c wrangler.writer.jsonc",
    "deploy:writer:sandbox": "wrangler deploy -c wrangler.writer.jsonc --env sandbox",
    "typecheck": "wrangler types --include-runtime=false && tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "hono": "^4.13.18",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
